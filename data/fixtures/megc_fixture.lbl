PDS_VERSION_ID = PDS3
/* SYNTHETIC TEST FIXTURE — NOT NASA DATA. Mimics MOLA MEGDR layout for software testing. */
RECORD_TYPE = FIXED_LENGTH
RECORD_BYTES = 512
FILE_RECORDS = 256
^IMAGE = "MEGC_FIXTURE.IMG"
DATA_SET_ID = "MARSCOPE-SYNTHETIC-FIXTURE"
PRODUCT_ID = "MEGC_FIXTURE"
NOTE = "SYNTHETIC TEST FIXTURE - NOT NASA DATA (counts)"
OBJECT = IMAGE
  LINES = 256
  LINE_SAMPLES = 256
  SAMPLE_TYPE = MSB_UNSIGNED_INTEGER
  SAMPLE_BITS = 16
  UNIT = COUNT
  SCALING_FACTOR = 1
  OFFSET = 0
END_OBJECT = IMAGE
OBJECT = IMAGE_MAP_PROJECTION
  MAP_PROJECTION_TYPE = "SIMPLE CYLINDRICAL"
  A_AXIS_RADIUS = 3396.0 <KM>
  POSITIVE_LONGITUDE_DIRECTION = EAST
  MAP_RESOLUTION = 128 <PIX/DEG>
  MAXIMUM_LATITUDE = 19.5 <DEG>
  MINIMUM_LATITUDE = 17.5 <DEG>
  WESTERNMOST_LONGITUDE = 76.5 <DEG>
  EASTERNMOST_LONGITUDE = 78.5 <DEG>
  LINE_PROJECTION_OFFSET = 2495.5
END_OBJECT = IMAGE_MAP_PROJECTION
END
